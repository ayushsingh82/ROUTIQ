# ROUTIQ — copy to .env.local and fill in. Never commit real credentials.

# ── Inference providers (optional: a provider is only active if its key is set) ──────────
# The built-in local provider talks to Ollama (https://ollama.com). No key needed.
OLLAMA_URL=http://127.0.0.1:11434/v1
# Set to 1 to hide the local provider (useful to demo routing between the other endpoints).
ROUTIQ_DISABLE_OLLAMA=0
# Hosted OpenAI-compatible providers. Add them in routiq.providers.json with an `apiKeyEnv` pointing at one of these.
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPSEEK_API_KEY=

# ── Gateway ─────────────────────────────────────────────────────────────────────────────
# Where hashed API keys, usage, routing history and registered providers are stored (gitignored).
ROUTIQ_DATA_DIR=.data
# If set, key management endpoints require the header `x-admin-token: <value>`. Set this on any public deployment.
ROUTIQ_ADMIN_TOKEN=

# ── Ethereum / Anon-RPC (browser) ───────────────────────────────────────────────────────
# The Alternative Mempool devnet (chain 1337). RPC is what the Anon-RPC exit node fetches on the user's behalf.
NEXT_PUBLIC_ROUTIQ_CHAIN_ID=1337
NEXT_PUBLIC_ROUTIQ_RPC_URL=https://altmempool.forshtat.com
NEXT_PUBLIC_ROUTIQ_SIDECAR_RPC_URL=https://altmempool.forshtat.com/rpc
# Deployed ProviderRegistry on the devnet (filled in by the deploy script).
NEXT_PUBLIC_ROUTIQ_REGISTRY_ADDRESS=
# Anon-RPC network used by default in the browser: nox | tor-js | nym   (passthrough is never allowed in private mode)
NEXT_PUBLIC_ANON_RPC_NETWORK=nox
