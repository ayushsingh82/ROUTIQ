{
  "name": "routiq",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --no-warnings \"src/lib/**/*.test.ts\"",
    "provider:alpha": "node --no-warnings scripts/provider-node.mts --name \"Reference Provider Alpha\" --port 4101",
    "provider:beta": "node --no-warnings scripts/provider-node.mts --name \"Reference Provider Beta\" --port 4102",
    "smoke": "node --no-warnings scripts/browser-smoke.mts",
    "check:anon": "node --no-warnings scripts/anon-devnet-check.mts",
    "contracts:build": "forge build",
    "deploy:devnet": "node --no-warnings scripts/deploy-devnet.mts",
    "stake:devnet": "node --no-warnings scripts/stake-devnet.mts",
    "agent:spend": "node --no-warnings scripts/agent-spend.mts 250000 30000000",
    "check:frame": "node --no-warnings scripts/frame-tx-check.mts",
    "check:registration": "node --no-warnings scripts/registration-check.mts",
    "shot": "node --no-warnings scripts/shot.mts"
  },
  "dependencies": {
    "@anon-rpc/browser-harness": "^0.4.0",
    "@forshtat/hegota-support": "^0.0.1",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.106.1",
    "@x402/core": "^2.30.0",
    "@x402/evm": "^2.30.0",
    "@x402/svm": "^2.30.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "^2.57.16",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "ROUTIQ — privacy-aware AI inference router and agent payment layer (OpenAI-compatible API, Anon-RPC reads, Alt-Mempool devnet)",
  "license": "MIT"
}
